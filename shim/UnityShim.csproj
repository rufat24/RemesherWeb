<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>UnityShim</AssemblyName>
    <RootNamespace>UnityEngine</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>CS1591;CS0108;CS0809</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ShimFloatMath)'=='true'">
    <DefineConstants>$(DefineConstants);SHIM_FLOAT_MATH</DefineConstants>
  </PropertyGroup>
</Project>
