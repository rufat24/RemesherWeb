<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>NativeRemesher.Bench</AssemblyName>
    <RootNamespace>NativeRemesher.Benchmark</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS1591;CS0108;CS0809;CS0618;CS0649;CS0169;CS0219;CS0414;CS8981;CS1587;CS1573;CS1572;CS1574;CS0067</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../upstream/Benchmark/**/*.cs" />
    <Compile Include="*.cs" />
    <ProjectReference Include="../core/NativeRemesher.Core.csproj" />
    <ProjectReference Include="../shim/UnityShim.csproj" />
  </ItemGroup>
</Project>
