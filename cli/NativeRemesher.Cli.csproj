<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>NativeRemesher.Cli</AssemblyName>
    <RootNamespace>NativeRemesher.Cli</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS1591;CS0108;CS0809;CS0618;CS0649;CS0169;CS0219;CS0414;CS8981;CS1587;CS1573;CS1572;CS1574;CS0067</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs;../wasm/CaseRunner.cs" />
    <Compile Include="../upstream/Benchmark/MeshCorpus.cs;../upstream/Benchmark/MeshMetrics.cs;../upstream/Benchmark/PolyMesh.cs;../upstream/Benchmark/BenchmarkReport.cs;../upstream/Benchmark/FieldDiagnostics.cs;../upstream/Benchmark/IntegerGridAudit.cs;../upstream/Benchmark/ObjReader.cs;../upstream/Benchmark/ObjWriter.cs" />
    <ProjectReference Include="../core/NativeRemesher.Core.csproj" />
    <ProjectReference Include="../shim/UnityShim.csproj" />
  </ItemGroup>
</Project>
