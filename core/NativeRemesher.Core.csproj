<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>NativeRemesher.Runtime</AssemblyName>
    <RootNamespace>NativeRemesher</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS1591;CS0108;CS0809;CS0618;CS0649;CS0169;CS0219;CS0414;CS8981;CS1587;CS1573;CS1572;CS1574;CS0067</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Upstream Runtime, unchanged. The two MonoBehaviours are excluded explicitly: a new one upstream must fail loudly. -->
    <Compile Include="../upstream/Runtime/**/*.cs"
             Exclude="../upstream/Runtime/RemeshPaint.cs;../upstream/Runtime/RemeshSource.cs" />
    <ProjectReference Include="../shim/UnityShim.csproj" />
  </ItemGroup>
</Project>
